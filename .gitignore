# Tree QC research artifacts; source/config/reports remain tracked
research/tree_qc/**/__pycache__/
research/tree_qc/**/*.pt
research/tree_qc/**/*.pth
research/tree_qc/**/*.onnx
research/tree_qc/.venv/
research/tree_qc/data/
research/tree_qc/outputs/
# Volatile run telemetry (wall-clock timing); the frozen artifact is fully deterministic
research/tree_qc/reports/GATE_D_DIAGNOSTIC_RUNTIME.json

# Tree QC V2 feasibility round. Source, config and reports are tracked; the ROI
# library, checkpoints, per-row dumps and the large input point clouds are not.
research/tree_qc_v2/**/__pycache__/
research/tree_qc_v2/**/*.pt
research/tree_qc_v2/**/*.pth
research/tree_qc_v2/**/*.onnx
research/tree_qc_v2/**/*.npz
# Per-row bakeoff dumps: thousands of scored examples per model, regenerated by
# re-running the bakeoff. The aggregate report is tracked instead.
research/tree_qc_v2/reports/BAKEOFF_ROWS_*.json
research/tree_qc_v2/reports/*_QUICK.json

# Tree QC V2.5 GO/NO-GO round. Source, configs, frozen gates and reports are
# tracked; the per-row dumps are ~7 MB of scored examples that the runner
# regenerates, so they stay out of the repository. Both protocol revisions are
# tracked in aggregate, because the revision is part of the record.
research/tree_qc_v25/**/__pycache__/
research/tree_qc_v25/**/*.pt
research/tree_qc_v25/**/*.pth
research/tree_qc_v25/**/*.onnx
research/tree_qc_v25/**/*.npz
research/tree_qc_v25/reports/V25_ROWS_*.json
research/tree_qc_v25/reports/PILOT_V1_UNWEIGHTED_ROWS_*.json
